      "parameters": {
        "jsCode": "// Load subscribers from persistent static data\nconst staticData = $getWorkflowStaticData('global');\nconst subscribers = staticData.subscribers || [];\n\nreturn [{\n  json: {\n    shouldSend: subscribers.length > 0,\n    subscribers,\n    subscriberCount: subscribers.length,\n    reason: subscribers.length === 0\n      ? 'No subscribers yet — skipping broadcast'\n      : `Sending digest to ${subscribers.length} subscriber(s)!`\n  }\n}];"
      },
