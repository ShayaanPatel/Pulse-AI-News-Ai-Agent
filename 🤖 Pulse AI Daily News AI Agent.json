    {
      "parameters": {
        "promptType": "define",
        "text": "=You are an expert AI journalist and news curator. Today is {{ $json.today }}.\n\nI have collected {{ $json.articleCount }} AI-related articles from Google News, HackerNews, and MIT Technology Review.\n\nYour task:\n1. Select the TOP 10 most important and unique AI stories from today\n2. PRIORITIZE: new model releases, research breakthroughs, major company announcements, AI policy/regulation, funding rounds, open-source releases\n3. AVOID duplicates — if multiple sources cover the same story, pick the best version\n4. Write an engaging, concise Telegram digest with emoji\n5. Keep each summary to 1-2 sentences max\n\nOutput EXACTLY this format (no extra text, no markdown code blocks):\n\n🤖 *Daily AI News Digest*\n📅 {{ $json.today }}\n━━━━━━━━━━━━━━━━━━━━━━━━\n\n1️⃣ *[Headline]* — [1-2 sentence summary]\n\n2️⃣ *[Headline]* — [summary]\n\n3️⃣ *[Headline]* — [summary]\n\n4️⃣ *[Headline]* — [summary]\n\n5️⃣ *[Headline]* — [summary]\n\n6️⃣ *[Headline]* — [summary]\n\n7️⃣ *[Headline]* — [summary]\n\n8️⃣ *[Headline]* — [summary]\n\n9️⃣ *[Headline]* — [summary]\n\n🔟 *[Headline]* — [summary]\n\n━━━━━━━━━━━━━━━━━━━━━━━━\n💡 _Curated by PulseAIAgent_ | _/stop to unsubscribe_\n\nRaw articles to analyze:\n\n{{ $json.rawContent }}"
      },
      "id": "llm-chain",
      "name": "🧠 AI Summarizer Chain",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.4,
      "position": [
        1968,
        560
      ]
    },
    {
      "parameters": {
        "jsCode": "// Get the AI-generated digest\nconst digest = $('🧠 AI Summarizer Chain').item.json.text\n  || '⚠️ *AI Digest Unavailable*\\n\\nCould not generate today\\'s digest. Please check back tomorrow!';\n\n// Get all subscribers from static data\nconst staticData = $getWorkflowStaticData('global');\nconst subscribers = staticData.subscribers || [];\n\nif (subscribers.length === 0) {\n  return [{ json: { skipped: true, reason: 'No subscribers to send to' } }];\n}\n\n// Return one item per subscriber so the Telegram node sends to each\nreturn subscribers.map(sub => ({\n  json: {\n    chatId: sub.chatId,\n    firstName: sub.firstName,\n    digest\n  }\n}));"
      },
