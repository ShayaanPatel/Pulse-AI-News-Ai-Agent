      "parameters": {
        "jsCode": "// Store requester's chatId in static data for after the AI processing\nconst staticData = $getWorkflowStaticData('global');\nconst msg = $json.message;\nstaticData.nowChatId = String(msg.chat.id);\nstaticData.nowFirstName = msg.from?.first_name || 'Friend';\nreturn [{ json: { triggered: true } }];"
      },
