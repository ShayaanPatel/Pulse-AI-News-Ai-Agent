    {
      "parameters": {
        "jsCode": "// Persist subscriber to workflow static data (survives restarts)\nconst staticData = $getWorkflowStaticData('global');\nif (!staticData.subscribers) staticData.subscribers = [];\n\nconst msg = $('📩 Telegram Bot Trigger').item.json.message;\nconst chatId = String(msg.chat.id);\nconst firstName = msg.from?.first_name || 'Friend';\nconst username = msg.from?.username || '';\n\nconst alreadySubscribed = staticData.subscribers.some(s => s.chatId === chatId);\n\nif (!alreadySubscribed) {\n  staticData.subscribers.push({\n    chatId,\n    firstName,\n    username,\n    subscribedAt: new Date().toISOString()\n  });\n}\n\nreturn [{ json: { chatId, firstName, alreadySubscribed, total: staticData.subscribers.length } }];"
      },
      "id": "code-subscribe",
      "name": "💾 Subscribe User",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        -48
      ]
    },
    {
      "parameters": {
        "jsCode": "// Remove subscriber from workflow static data\nconst staticData = $getWorkflowStaticData('global');\nif (!staticData.subscribers) staticData.subscribers = [];\n\nconst msg = $('📩 Telegram Bot Trigger').item.json.message;\nconst chatId = String(msg.chat.id);\nconst firstName = msg.from?.first_name || 'Friend';\n\nconst wasSubscribed = staticData.subscribers.some(s => s.chatId === chatId);\nstaticData.subscribers = staticData.subscribers.filter(s => s.chatId !== chatId);\n\nreturn [{ json: { chatId, firstName, wasSubscribed, total: staticData.subscribers.length } }];"
      },
